+            if list(getattr(lane, "libraries", []) or [])
+        ]
+
+    def _restore_originals(source_identities: Set[str]) -> List[EnhancedLibraryInfo]:
+        restored: List[EnhancedLibraryInfo] = []
+        seen: Set[str] = set()
+        for source_identity in source_identities:
+            if source_identity in seen:
+                continue
+            source = source_by_identity.get(source_identity)
+            if source is None:
+                continue
+            if hasattr(source, "_priority_preconsume_source_identity"):

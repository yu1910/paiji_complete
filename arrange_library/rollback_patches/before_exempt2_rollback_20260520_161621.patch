+            if source_identity in family_expected:
+                assigned_by_source.setdefault(source_identity, []).append((lane, lib))
+
+    complete_sources: Set[str] = set()
+    rollback_sources: Set[str] = set()
+    for source_identity, expected_count in family_expected.items():
+        assigned_count = len(assigned_by_source.get(source_identity, []))
+        if assigned_count == int(expected_count or 0):
+            complete_sources.add(source_identity)
+        elif assigned_count > 0:
+            rollback_sources.add(source_identity)
+
+    removed_fragments = 0
